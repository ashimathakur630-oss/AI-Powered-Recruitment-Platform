    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an experienced HR recruiter.\n\nAnalyze the candidate's resume and evaluate their suitability for the job.\n\nCandidate Details:\nName: {{$json.name}}\nEmail: {{$json.email}}\nPosition Applied: {{$json.position}}\n\nResume Text:\n{{$json.text}}\n\nInstructions:\n1. Evaluate the candidate based on:\n   - Technical skills\n   - Relevant work experience\n   - Education\n   - Projects\n   - Certifications (if any)\n   - Overall suitability for the applied position\n\n2. Assign an AI score between 0 and 100.\n\n3. List 3 to 5 strengths.\n\n4. List 2 to 4 weaknesses.\n\n5. Write a short recommendation.\n   - If AI score is 70 or above, recommend the candidate for interview.\n   - If AI score is below 70, recommend rejection.\n\n6. If the AI score is 70 or above, schedule the interview exactly 3 days from today.\n   If the score is below 70, leave the interview_date empty.\n\nReturn ONLY valid JSON.\n\n{\n  \"name\": \"{{$json.name}}\",\n  \"email\": \"{{$json.email}}\",\n  \"position\": \"{{$json.position}}\",\n  \"resume_file\": \"{{$json.resume_file}}\",\n  \"ai_score\": 85,\n  \"strengths\": [\n    \"Strong Python programming\",\n    \"Excellent SQL knowledge\",\n    \"Good communication skills\"\n  ],\n  \"weaknesses\": [\n    \"Limited industry experience\",\n    \"Needs improvement in cloud technologies\"\n  ],\n  \"recommendations\": \"Recommended for interview.\",\n  \"interview_date\": \"2026-08-01\"\n}\n\nDo not include explanations, markdown, or any text outside the JSON object.",
        "hasOutputParser": true,
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1024,
        0
      ],
      "id": "9e4a314a-8cd4-4cd4-844b-26414512da9c",
      "name": "Basic LLM Chain"
    },
