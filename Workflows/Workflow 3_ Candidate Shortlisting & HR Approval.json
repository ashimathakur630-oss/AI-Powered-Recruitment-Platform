        "sendTo": "ashimathakur630@gmail.com",
        "subject": "=HR Approval Required - {{$json.name}}",
        "message": "=<html>\n<body style=\"font-family: Arial, sans-serif; background:#f4f4f4; padding:30px;\">\n\n<div style=\"max-width:700px; margin:auto; background:#ffffff; padding:30px; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,0.1);\">\n\n<h2 style=\"color:#2c3e50;\">\nAI Recruitment Platform - HR Approval Required\n</h2>\n\n<p>Hello HR Team,</p>\n\n<p>\nA new candidate has successfully completed the AI Resume Evaluation stage and requires your approval before proceeding to the interview process.\n</p>\n\n<hr>\n\n<h3>Candidate Details</h3>\n\n<table style=\"border-collapse:collapse; width:100%;\">\n\n<tr>\n<td><b>Name</b></td>\n<td>{{$json.name}}</td>\n</tr>\n\n<tr>\n<td><b>Email</b></td>\n<td>{{$json.email}}</td>\n</tr>\n\n<tr>\n<td><b>Position</b></td>\n<td>{{$json.position}}</td>\n</tr>\n\n<tr>\n<td><b>AI Score</b></td>\n<td>{{$json.ai_score}} / 100</td>\n</tr>\n\n<tr>\n<td><b>Recommendation</b></td>\n<td>{{ $json.recommendations }}</td>\n</tr>\n\n</table>\n\n<br>\n\n<h3>Strengths</h3>\n\n<p>{{$json.strengths}}</p>\n\n<h3>Weaknesses</h3>\n\n<p>{{$json.weaknesses}}</p>\n\n<br>\n\n<table cellpadding=\"0\" cellspacing=\"0\">\n<tr>\n\n<td>\n\n<a href=\"{{$execution.resumeUrl}}&action=approve&id={{$json.id}}\"\nstyle=\"\nbackground:#28a745;\ncolor:white;\npadding:14px 28px;\ntext-decoration:none;\nborder-radius:6px;\nfont-weight:bold;\ndisplay:inline-block;\">\nApprove Candidate\n</a>\n\n</td>\n\n<td width=\"20\"></td>\n\n<td>\n\n<a href=\"{{$execution.resumeUrl}}&action=reject&id={{$json.id}}\"\nstyle=\"\nbackground:#dc3545;\ncolor:white;\npadding:14px 28px;\ntext-decoration:none;\nborder-radius:6px;\nfont-weight:bold;\ndisplay:inline-block;\">\nReject Candidate\n</a>\n\n</td>\n\n</tr>\n</table>\n\n<br><br>\n\n<hr>\n\n<p>\n<b>Regards,</b><br>\nAI Recruitment Platform\n</p>\n\n<p style=\"font-size:12px;color:gray;\">\nThis email was generated automatically by n8n.\n</p>\n\n</div>\n\n</body>\n</html>",
